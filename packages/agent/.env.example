# ============================================================
# PIXPORT Agent — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit the .env file — it's in .gitignore
# ============================================================

# ---- Hedera TESTNET credentials ----
# Get a free testnet account at https://portal.hedera.com/dashboard
HEDERA_ACCOUNT_ID="0.0.XXXXX"
HEDERA_PRIVATE_KEY="0x..."         # ECDSA hex-encoded private key
HEDERA_NETWORK="testnet"           # always testnet for this demo

# ---- Hedera on-chain artifact IDs (Block 1 testnet deployment) ----
HEDERA_HTS_TOKEN_ID="0.0.9742957"  # HTS fungible token (real testnet ID)
HEDERA_HCS_TOPIC_ID="0.0.9742958"  # HCS audit topic (real testnet ID)
HEDERA_TREASURY_ID="0.0.9742864"   # Token owner/treasury account

# ---- PIXPORT Gateway (set by GatewayEngineer after Block 1) ----
GATEWAY_URL="http://localhost:3001" # Base URL for POST /pay
GATEWAY_API_KEY=""                  # Optional bearer token for the gateway

# ---- World IDKit ----
# Register your app at https://developer.worldcoin.org
WORLD_APP_ID="app_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"   # starts with app_
WORLD_ACTION="pixport-payment"      # action string, must match portal config

# ---- World IDKit verification environment ----
# "production" → real World App / Orb verification
# "staging"    → simulator (https://simulator.worldcoin.org) — no phone needed
WORLD_ENV="staging"

# ---- LLM (for hedera-agent-kit LangChain integration) ----
# Choose ONE:
ANTHROPIC_API_KEY="sk-ant-..."     # Claude (recommended)
# OPENAI_API_KEY="sk-proj-..."     # GPT alternative
# GROQ_API_KEY="gsk_..."           # Free tier option

# ---- Allowance tiers ----
# These map World ID verification level to HIP-336 max spend (in token minor units)
TIER_ORB_MAX="1000000"             # Orb-verified human: 1,000,000 units
TIER_DEVICE_MAX="100000"           # Device-verified:    100,000  units
TIER_UNVERIFIED_MAX="0"            # Unverified: rejected — no payments allowed

# ---- Demo / dev bypass flags ----
# Set WORLD_MOCK=true to skip World ID Cloud API call (accepts proof verification_level as-is)
# Safe for dev testing and judge demos — do not use in production
WORLD_MOCK="false"

# Set GATEWAY_MOCK=true to skip the real POST /pay network call (returns a synthetic E2E ID)
# Use when running the demo without the gateway server started
GATEWAY_MOCK="false"
