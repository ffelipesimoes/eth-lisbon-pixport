{
  "name": "@pixport/hedera",
  "version": "0.1.0",
  "description": "PIXPORT Hedera on-chain setup: HTS token, HCS topic, HIP-336 allowances, Scheduled Transactions",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "setup": "npx tsx src/setup.ts",
    "allowance": "npx tsx src/allowance-demo.ts",
    "scheduled": "npx tsx src/scheduled.ts",
    "demo": "npx tsx src/demo.ts",
    "module-test": "npx tsx src/module-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.80.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
