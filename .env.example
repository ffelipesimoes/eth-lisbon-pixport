# ============================================================
# PIXPORT — Environment Variables
# Copy to .env and fill in real values (never commit .env)
# ============================================================

# ── Hedera TESTNET (get account at https://portal.hedera.com/) ──
# HEDERA_OPERATOR_ID  = your testnet account ID (e.g. 0.0.12345)
# HEDERA_OPERATOR_KEY = DER-encoded ED25519 private key from portal
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.XXXXXXX
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Created by `npm run setup` (packages/hedera) ──
# Values from Block 1 testnet deployment:
HTS_TOKEN_ID=0.0.9742957
HCS_TOPIC_ID=0.0.9742958
HEDERA_TREASURY_ID=0.0.9742864

# ── Created by `npm run allowance` (HIP-336 demo, set automatically) ──
# HEDERA_SPENDER_ID is the payerAccountId for POST /pay
HEDERA_SPENDER_ID=0.0.XXXXXXX
HEDERA_SPENDER_KEY=302e020100300506032b657004220420XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Aliases used by @pixport/agent
HEDERA_ACCOUNT_ID=${HEDERA_OPERATOR_ID}
HEDERA_PRIVATE_KEY=${HEDERA_OPERATOR_KEY}
HEDERA_HTS_TOKEN_ID=${HTS_TOKEN_ID}
HEDERA_HCS_TOPIC_ID=${HCS_TOPIC_ID}

# ── Pix Payout Credentials (Felipe plugs in real values) ──
# PSP: Efí (Gerencianet) — https://dev.efipay.com.br/docs/api-pix
# NEVER commit real credentials. This file is safe — .env is gitignored.
#
# Setup steps:
#   1. Create account at https://app.efipay.com.br/
#   2. Enable Pix API in your account settings
#   3. Generate mTLS certificate (portal → Minha Conta → Certificados)
#   4. Save the .p12 or PEM files; convert with:
#        openssl pkcs12 -in cert.p12 -clcerts -nokeys -out mtls-cert.pem
#        openssl pkcs12 -in cert.p12 -nocerts -nodes -out mtls-key.pem
#   5. Copy CLIENT_ID and CLIENT_SECRET from the portal API credentials page
#   6. PIX_KEY = your registered Pix key (e-mail, CPF, CNPJ, phone, or random UUID)
#
# Sandbox (homologação): PIX_SANDBOX=true → uses pix-h.api.efipay.com.br
# Production:            PIX_SANDBOX=false (or omit) → uses pix.api.efipay.com.br
# PIX_API_BASE_URL overrides the automatic URL selection if set explicitly.
#
# Self-pay R$0.01 test: set PIX_KEY to your own Pix key and call POST /pay.
PIX_SANDBOX=true
PIX_API_BASE_URL=https://pix-h.api.efipay.com.br
PIX_CLIENT_ID=your-client-id-here
PIX_CLIENT_SECRET=your-client-secret-here
PIX_CERT_PATH=/path/to/mtls-cert.pem
PIX_KEY_PATH=/path/to/mtls-key.pem
PIX_KEY=your-pix-key-here

# ── Gateway ──
GATEWAY_PORT=3001
NODE_ENV=development

# ── Next.js Console ──
# GATEWAY_URL  — used by next.config.mjs for the /api/gateway proxy rewrite (server-side)
GATEWAY_URL=http://localhost:3001
# NEXT_PUBLIC_GATEWAY_URL — legacy; kept for reference (not used by proxy)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
