# ============================================================
# PIXPORT — Environment Variables
# Copy to .env and fill in real values (never commit .env)
# ============================================================

# ── Hedera TESTNET (get account at https://portal.hedera.com/) ──
# HEDERA_OPERATOR_ID  = your testnet account ID (e.g. 0.0.12345)
# HEDERA_OPERATOR_KEY = DER-encoded ED25519 private key from portal
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.XXXXXXX
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Created by `npm run setup` (packages/hedera) ──
# Values from Block 1 testnet deployment:
HTS_TOKEN_ID=0.0.9742957
HCS_TOPIC_ID=0.0.9742958
HEDERA_TREASURY_ID=0.0.9742864

# ── Created by `npm run allowance` (HIP-336 demo, set automatically) ──
# HEDERA_SPENDER_ID is the payerAccountId for POST /pay
HEDERA_SPENDER_ID=0.0.XXXXXXX
HEDERA_SPENDER_KEY=302e020100300506032b657004220420XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Aliases used by @pixport/agent
HEDERA_ACCOUNT_ID=${HEDERA_OPERATOR_ID}
HEDERA_PRIVATE_KEY=${HEDERA_OPERATOR_KEY}
HEDERA_HTS_TOKEN_ID=${HTS_TOKEN_ID}
HEDERA_HCS_TOPIC_ID=${HCS_TOPIC_ID}

# ── Pix Payout Credentials — PSP: Bitpag (https://bitpag.io) ──
# NUNCA commitar valores reais. Este arquivo é seguro — .env está no .gitignore.
#
# Setup steps:
#   1. Crie conta em https://app.bitpag.xyz e acesse Configurações → API
#   2. Copie o API Key (Bearer de longa duração) → PIX_API_KEY
#   3. Copie CLIENT_ID e CLIENT_SECRET das credenciais OAuth → PIX_CLIENT_ID / PIX_CLIENT_SECRET
#   4. PIX_KEY = sua chave Pix (e-mail, CPF, CNPJ, telefone, ou UUID aleatório)
#
# Auth flow: POST /api/auth com Bearer PIX_API_KEY + client_id/secret no body
#            -> retorna JWT de curta duração -> usado em POST /api/payments/pix-out
#
# Self-pay R$0,01: coloque sua própria chave Pix em PIX_KEY e chame POST /pay
# No mTLS required — PIX_CERT_PATH / PIX_KEY_PATH não são usados pelo adapter Bitpag.
PIX_API_BASE_URL=https://api.bitpag.xyz
PIX_API_KEY=your-long-lived-api-key-here
PIX_CLIENT_ID=your-client-id-here
PIX_CLIENT_SECRET=your-client-secret-here
PIX_KEY=your-pix-key-here

# ── World Identity Check (Beta) — agent + gateway ──
# Register app/action at https://developer.worldcoin.org (staging app for the demo).
# WORLD_APP_ID — staging app id looks like app_staging_XXXXXXXXXXXXXXXX
# WORLD_ACTION — action name registered in the portal (default: pixport-payment)
# WORLD_ENV    — staging | production (must match the app's portal environment)
WORLD_APP_ID=app_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WORLD_ACTION=pixport-payment
WORLD_ENV=staging

# Stage fallback (dev/judge use only — never in production):
# WORLD_MOCK=true makes the backend trust the proof's verification_level without
# calling the Cloud API. This is the implementation of the spec's SKIP_WORLDID flag.
WORLD_MOCK=false

# Tier caps in BRL minor units (centavos) — tier → allowance ceiling:
#   orb (Identity Check) → 1000000 = R$ 10.000,00 per payment
#   device               → 100000  = R$ 1.000,00 per payment
#   unverified           → 0 (rejected)
TIER_ORB_MAX=1000000
TIER_DEVICE_MAX=100000
TIER_UNVERIFIED_MAX=0

# ── Gateway ──
GATEWAY_PORT=3001
NODE_ENV=development

# ── Next.js Console ──
# GATEWAY_URL  — used by next.config.mjs for the /api/gateway proxy rewrite (server-side)
GATEWAY_URL=http://localhost:3001
# NEXT_PUBLIC_GATEWAY_URL — legacy; kept for reference (not used by proxy)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
# NEXT_PUBLIC_SKIP_WORLDID=true — console stage fallback: replaces the IDKit widget
# with a pre-applied tier selector (orb/device) that submits a mock proof to the
# gateway. Requires WORLD_MOCK=true on the gateway. Alias of the spec's SKIP_WORLDID.
NEXT_PUBLIC_SKIP_WORLDID=false
